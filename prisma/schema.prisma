generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id            String         @id @default(cuid())
  name          String
  logoPath      String?
  sourceUrl     String?
  // Default size multiplier for this logo (0.5-2.0), applied everywhere it's used unless
  // a specific sponsorship overrides it further via EventSponsor.scale.
  logoScale     Float          @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  eventSponsors EventSponsor[]
  signs         Sign[]

  @@index([name])
}

model Event {
  id              String         @id @default(cuid())
  name            String
  logoPath        String?
  primaryColor    String         @default("#0a2f5c")
  accentColor     String         @default("#e8384f")
  topTierLabel    String         @default("Presenting Sponsors")
  // Logos per row for all sponsor rows except Presenting (always its own solo row). 2, 3, or 4.
  logosPerRow     Int            @default(4)
  // Size multiplier for General-tier logo cells (0.5-2.0, 1.2 = default 20% bump over base).
  generalScale    Float          @default(1.2)
  // Draws a category label (e.g. "Gold") above each tier's row block, except General.
  showTierLabels  Boolean        @default(false)
  // Draws a horizontal rule between the Bronze and General rows, when both are present.
  bronzeGeneralDivider Boolean   @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sponsors        EventSponsor[]
}

model EventSponsor {
  id        String      @id @default(cuid())
  eventId   String
  companyId String
  tier      String      @default("GENERAL")
  order     Int         @default(0)
  // Extra size multiplier (0.5-2.0) for this specific sponsorship's logo, on top of the
  // company's own logoScale — lets a logo be nudged bigger/smaller just for this placement.
  scale     Float       @default(1)
  createdAt DateTime    @default(now())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // A company can sponsor the same event at multiple tiers (e.g. General + Bronze), each
  // showing its logo in that tier's row — but not be added twice at the *same* tier.
  @@unique([eventId, companyId, tier])
}

// A reusable blank sign design: one or more physical sizes (e.g. "Small" / "Large"), each
// with its own uploaded blank PDF and its own text/logo placeholder box, saved once and
// reused across any number of sign sets.
model SignTemplate {
  id        String             @id @default(cuid())
  name      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  sizes     SignTemplateSize[]
  signSets  SignSet[]
}

model SignTemplateSize {
  id         String   @id @default(cuid())
  templateId String
  // e.g. "Small (8.5x11)" — matched (case-insensitively) against the "Size" column of an
  // imported sign list.
  label      String
  pdfPath    String
  // Page dimensions in PDF points, read from the uploaded PDF at upload time.
  pageWidth  Float
  pageHeight Float
  // Placeholder boxes, in PDF points, measured from the page's top-left corner (converted
  // to PDF's bottom-left origin at render time) — matches how the editor UI positions them.
  textBoxX  Float @default(0)
  textBoxY  Float @default(0)
  textBoxW  Float @default(0)
  textBoxH  Float @default(0)
  logoBoxX  Float @default(0)
  logoBoxY  Float @default(0)
  logoBoxW  Float @default(0)
  logoBoxH  Float @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  template SignTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  signs    Sign[]

  @@unique([templateId, label])
}

// One batch of signs generated for an event occasion from an uploaded sign list.
model SignSet {
  id         String   @id @default(cuid())
  name       String
  templateId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template SignTemplate @relation(fields: [templateId], references: [id])
  signs    Sign[]
}

// One generated sign, corresponding to one row of an imported sign list.
model Sign {
  id              String  @id @default(cuid())
  signSetId       String
  templateSizeId  String?
  companyId       String?
  // Raw values from the imported row (kept even if companyId / templateSizeId couldn't be
  // resolved, so the row is still visible and fixable in the UI).
  companyName     String
  sponsorship     String  @default("")
  sizeLabel       String
  // Per-sign overrides — set when the sign is edited individually after generation.
  textOverride    String?
  order           Int     @default(0)
  pdfPath         String?
  status          String  @default("pending") // ready | needs_attention
  note            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  signSet      SignSet           @relation(fields: [signSetId], references: [id], onDelete: Cascade)
  templateSize SignTemplateSize? @relation(fields: [templateSizeId], references: [id])
  company      Company?          @relation(fields: [companyId], references: [id])
}
