generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id            String         @id @default(cuid())
  name          String
  logoPath      String?
  sourceUrl     String?
  // Default size multiplier for this logo (0.5-2.0), applied everywhere it's used unless
  // a specific sponsorship overrides it further via EventSponsor.scale.
  logoScale     Float          @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  eventSponsors EventSponsor[]

  @@index([name])
}

model Event {
  id              String         @id @default(cuid())
  name            String
  logoPath        String?
  primaryColor    String         @default("#0a2f5c")
  accentColor     String         @default("#e8384f")
  topTierLabel    String         @default("Presenting Sponsors")
  // Logos per row for all sponsor rows except Presenting (always its own solo row). 2, 3, or 4.
  logosPerRow     Int            @default(4)
  // Size multiplier for General-tier logo cells (0.5-2.0, 1.2 = default 20% bump over base).
  generalScale    Float          @default(1.2)
  // Draws a category label (e.g. "Gold") above each tier's row block, except General.
  showTierLabels  Boolean        @default(false)
  // Draws a horizontal rule between the Bronze and General rows, when both are present.
  bronzeGeneralDivider Boolean   @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sponsors        EventSponsor[]
}

model EventSponsor {
  id        String      @id @default(cuid())
  eventId   String
  companyId String
  tier      String      @default("GENERAL")
  order     Int         @default(0)
  // Extra size multiplier (0.5-2.0) for this specific sponsorship's logo, on top of the
  // company's own logoScale — lets a logo be nudged bigger/smaller just for this placement.
  scale     Float       @default(1)
  createdAt DateTime    @default(now())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // A company can sponsor the same event at multiple tiers (e.g. General + Bronze), each
  // showing its logo in that tier's row — but not be added twice at the *same* tier.
  @@unique([eventId, companyId, tier])
}
