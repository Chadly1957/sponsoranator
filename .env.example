# Postgres connection string. On Vercel, create a Postgres database under
# your project's Storage tab and copy the connection string it gives you
# (or set this env var name explicitly to match whatever it names it).
DATABASE_URL="postgresql://user:password@localhost:5432/sponsoranator"

# Vercel Blob read/write token, used to store uploaded/imported logo files.
# Create a Blob store under your project's Storage tab — Vercel auto-injects
# this env var for you once it's linked to the project. For local dev, run
# `vercel env pull .env` after linking, or paste the token here manually.
BLOB_READ_WRITE_TOKEN=""
